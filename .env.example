# ==========================================
# last.fm configuration
# ==========================================
# you can generate an API key at: https://www.last.fm/api/account/create
LASTFM_API_KEY="your_lastfm_api_key_here"
LASTFM_USERNAME="your_lastfm_username"

# ==========================================
# supabase configuration (backend / admin)
# ==========================================
# WARNING: the service key has full database access 
# NEVER expose this to the browser (do not prefix with NEXT_PUBLIC_)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_KEY="your_supabase_service_role_key"

# ==========================================
# supabase Configuration (Frontend / Client)
# ==========================================
# these keys are safe to expose to the browser and next.js client components
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"